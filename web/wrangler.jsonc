{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "english-app",
  "compatibility_date": "2026-06-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Safety net: point wrangler at the build output. IMPORTANT: `wrangler
    // deploy` must be preceded by `vite build` (use `npm run deploy`) — the
    // @cloudflare/vite-plugin build is what generates the real deploy config.
    // Deploying without building scans the raw web/ dir and hits the 25 MiB
    // limit on public/ffmpeg/ffmpeg-core.wasm.
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
